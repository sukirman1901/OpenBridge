{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "**/token*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "backup/**", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "rm -*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" }
  ],
  "commands": {
    "goal": {
      "description": "Continue the autonomous agent plan",
      "template": "Read GOAL.md at the root of this repository. Find the first phase with a not-done (⬜) status, work through that phase until its Done criteria are met, run its tests, refresh the checkbox statuses in GOAL.md, and report the results. Follow the Guardrails section. Do not skip phases."
    }
  }
}
