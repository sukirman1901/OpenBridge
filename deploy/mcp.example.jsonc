{
  "$schema": "https://opencode.ai/config.json",
  // Native V2: merge selected entries under mcp.servers, NOT directly under mcp.
  // These are opt-in examples, not connected integrations. No packages or OAuth
  // flows are installed/run by OpenBridge. Verify upstream maintenance/version
  // and least-privilege scopes before enabling a connector.
  //
  // Gmail: complete the upstream server's OAuth setup; its default private
  // credential files live under ~/.gmail-mcp/. Do not put refresh tokens here.
  // Drive: GDRIVE_CREDENTIALS_PATH is a FILE PATH to the upstream credential
  // JSON, not the JSON contents. Keep that file mode 0600 outside the repo.
  // GitHub: install the official github-mcp-server binary separately and supply
  // its token through the service environment, never through committed config.
  // OpenCode watches config changes; check connectivity with opencode mcp list.
  "mcp": {
    "servers": {
      "gmail": {
        "type": "local",
        "command": ["npx", "-y", "@gongrzhe/server-gmail-autoauth-mcp"],
        "disabled": true
      },
      "gdrive": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-gdrive"],
        "disabled": true,
        "environment": {
          "GDRIVE_CREDENTIALS_PATH": "{env:GDRIVE_CREDENTIALS_PATH}"
        }
      },
      "github": {
        "type": "local",
        "command": ["github-mcp-server", "stdio"],
        "disabled": true,
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
